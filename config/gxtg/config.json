                                        "mapping": {
                                            "冲销.+空头": "35",
                                            "冲销.+多头": "45",
                                            "空头": "3",
                                            "多头": "4",
                                            "认沽": "6",
                                            "认购": "7",
                                            "$_": ""
                                        }
                                    }
                                ],
                                "INV_CLS_CODE": [
                                    {
                                        "formula": "AST_CLS_CODE",
                                        "mapping": {
                                            "STOCK": "C",
                                            "FUND": "C",
                                            "BOND": "C",
                                            "$_": ""
                                        }
                                    },
                                    {
                                        "subject_filter_regex": "^2101\\w{5,}",
